# Explicit compiler-only upgrade of an existing pinned agent image.
ARG GO_IMAGE=golang@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea
ARG AGENT_IMAGE
FROM ${GO_IMAGE} AS compiler
FROM ${AGENT_IMAGE}
USER root
RUN rm -rf /usr/local/go
COPY --from=compiler /usr/local/go /usr/local/go
RUN test "$(go env GOVERSION)" = go1.27.4 && go version
